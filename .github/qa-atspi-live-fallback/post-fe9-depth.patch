+fn rename_subtree(nodes: &mut [Node], old_prefix: &str, new_prefix: &str) {
+    for node in nodes {
+        if node.key == old_prefix || node.key.starts_with(&format!("{old_prefix}/")) {
+            node.key = format!("{new_prefix}{}", &node.key[old_prefix.len()..]);
