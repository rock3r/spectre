 public sealed class AccessibilitySnapshotTests
 {
+    [Fact]
+    public void StreamProtocolWritesBomlessUtf8AndFlushesImmediately()
+    {
+        var input = new MemoryStream(Encoding.UTF8.GetBytes(Request("process-id", 7)));
+        var output = new TrackingMemoryStream();
+        var error = new TrackingMemoryStream();
+
+        var exitCode = AccessibilitySnapshotProtocol.Run(input, output, error, new FakeReader([Window(Node("root"))]));
+
+        Assert.Equal(0, exitCode);
+        Assert.True(output.WasFlushed);
+        Assert.False(output.ToArray().AsSpan().StartsWith(Encoding.UTF8.Preamble));
+        Assert.True(JsonDocument.Parse(output.ToArray()).RootElement.GetProperty("ok").GetBoolean());
+        Assert.Contains("stage=response-written", Encoding.UTF8.GetString(error.ToArray()));
+    }
+
+    [Fact]
+    public void BlockingReaderIsBoundedByTheRequestDeadline()
+    {
+        using var release = new ManualResetEventSlim();
+        var reader = new BlockingReader(release);
+        var started = Stopwatch.StartNew();
+
+        var result = AccessibilitySnapshotProtocol.RunForTest(Request("process-id", 7, timeout: 50), reader);
+
+        started.Stop();
+        release.Set();
+        Assert.True(started.Elapsed < TimeSpan.FromSeconds(2), $"protocol blocked for {started.Elapsed}");
+        using var json = JsonDocument.Parse(result.Output);
+        Assert.Equal("timeout", json.RootElement.GetProperty("error").GetProperty("code").GetString());
+    }
