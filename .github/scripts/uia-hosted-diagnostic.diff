+        }) { IsBackground = true, Name = "Spectre UI Automation reader" };
+        if (OperatingSystem.IsWindows()) worker.SetApartmentState(ApartmentState.MTA);
+        worker.Start();
+
+        var remaining = Math.Max(0, request.Timeout - watch.ElapsedMilliseconds);
+        if (!completion.Task.Wait(TimeSpan.FromMilliseconds(remaining)))
