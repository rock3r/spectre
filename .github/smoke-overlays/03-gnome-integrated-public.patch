index 0000000000000000000000000000000000000000..cf396751bffb2674e7f7e1c0f9a8a2a47861141e
--- /dev/null
+++ b/recording/native/linux/gnome-shell-extension/spectre-window-identity@sebastiano.dev/windowIdentity.js
@@ -0,0 +1,18 @@
+const X11_DESCRIPTION = /^0x([0-9a-fA-F]+)(?: \([\s\S]*\))?$/;
+export function parseX11WindowDescription(description) {
+    if (typeof description !== 'string') return null;
+    const match = description.match(X11_DESCRIPTION);
+    return match === null ? null : BigInt(`0x${match[1]}`);
+}
+export function windowMatchesXid(window, ownerPid, xid, x11ClientType) {
+    if (window.get_client_type() !== x11ClientType || window.get_pid() !== ownerPid) return false;
+    const windowXid = parseX11WindowDescription(window.get_description());
+    return windowXid !== null && windowXid === BigInt(xid);
+}
+export class OneTimeBindings {
