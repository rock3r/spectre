index 00000000..1e319b19
--- /dev/null
+++ b/recording/native/linux/gnome-shell-extension/spectre-window-identity@sebastiano.dev/windowIdentity.js
@@ -0,0 +1,51 @@
+const X11_DESCRIPTION = /^0x([0-9a-fA-F]+)(?: \([\s\S]*\))?$/;
+
+export function parseX11WindowDescription(description) {
+    if (typeof description !== 'string') return null;
+    const match = description.match(X11_DESCRIPTION);
+    return match === null ? null : BigInt(`0x${match[1]}`);
+}
+
+export function windowMatchesXid(window, ownerPid, xid, x11ClientType) {
+    if (window.get_client_type() !== x11ClientType || window.get_pid() !== ownerPid) return false;
+    const windowXid = parseX11WindowDescription(window.get_description());
+    return windowXid !== null && windowXid === BigInt(xid);
+}
+
+/**
+ * Short-lived handoffs from an authenticated lookup caller to the authenticated session client.
+ * A token belongs to one JVM PID, expires, and is consumed by every redemption attempt (including
+ * an owner mismatch), so it can never be probed and replayed.
+ */
+export class OneTimeBindings {
+    constructor(now = Date.now, ttlMs = 30_000, maximum = 256) {
+        this.values = new Map();
+        this.now = now;
+        this.ttlMs = ttlMs;
+        this.maximum = maximum;
+    }
+
+    cleanup() {
+        const now = this.now();
+        for (const [key, value] of this.values) {
+            if (value.expiresAt <= now) this.values.delete(key);
+        }
+    }
+
+    put(token, ownerPid, windowId) {
+        this.cleanup();
+        if (this.values.size >= this.maximum) throw new Error('too many pending window bindings');
+        this.values.set(token, {ownerPid, windowId, expiresAt: this.now() + this.ttlMs});
+    }
+
+    redeem(token, ownerPid) {
+        this.cleanup();
+        const value = this.values.get(token);
+        this.values.delete(token);
+        return value?.ownerPid === ownerPid ? value.windowId : null;
+    }
+
+    clear() {
+        this.values.clear();
+    }
+}
diff --git a/recording/native/linux/gnome-shell-extension/windowIdentity.test.mjs b/recording/native/linux/gnome-shell-extension/windowIdentity.test.mjs
new file mode 100644
index 00000000..d608f587
--- /dev/null
+++ b/recording/native/linux/gnome-shell-extension/windowIdentity.test.mjs
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import {
+    OneTimeBindings,
+    parseX11WindowDescription,
+    windowMatchesXid,
+} from './spectre-window-identity@sebastiano.dev/windowIdentity.js';
+
+const X11 = 1;
+const WAYLAND = 0;
+const window = ({clientType = X11, description = '0x2a', pid = 1234} = {}) => ({
+    get_client_type: () => clientType,
+    get_description: () => description,
+    get_pid: () => pid,
+});
+
+assert.equal(parseX11WindowDescription('0x2a'), 42n);
+assert.equal(parseX11WindowDescription('0x2a (title)'), 42n);
+for (const value of ['2a', 'prefix 0x2a', '0x2a title', '0x2a (title) trailing', '0x2aZZ']) {
+    assert.equal(parseX11WindowDescription(value), null, value);
+}
+assert(windowMatchesXid(window(), 1234, 42n, X11));
+assert(!windowMatchesXid(window({clientType: WAYLAND}), 1234, 42n, X11));
+assert(!windowMatchesXid(window({pid: 7}), 1234, 42n, X11));
+
+let now = 100;
+const bindings = new OneTimeBindings(() => now, 10, 2);
+bindings.put('good', 1234, 2n);
+assert.equal(bindings.redeem('good', 7), null);
+assert.equal(bindings.redeem('good', 1234), null);
+bindings.put('once', 1234, 2n);
+assert.equal(bindings.redeem('once', 1234), 2n);
+assert.equal(bindings.redeem('once', 1234), null);
+bindings.put('expires', 1234, 3n);
+now = 111;
+assert.equal(bindings.redeem('expires', 1234), null);
+bindings.put('a', 1, 1n);
+bindings.put('b', 1, 1n);
+assert.throws(() => bindings.put('c', 1, 1n), /too many/);
