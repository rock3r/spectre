+fn mutter_service_owner(conn: &Connection) -> Result<String> {
+    let result: std::result::Result<(String,), dbus::Error> = conn
+        .with_proxy(
+            "org.freedesktop.DBus",
+            "/org/freedesktop/DBus",
+            CALL_TIMEOUT,
