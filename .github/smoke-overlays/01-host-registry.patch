 }
 
+fn is_optional_host_registry_error(error: &dbus::Error) -> bool {
+    matches!(
+        error.name(),
+        Some(
+            "org.freedesktop.DBus.Error.UnknownInterface"
+                | "org.freedesktop.DBus.Error.UnknownMethod"
+        )
+    )
+}
+
+#[cfg(test)]
+mod host_registry_error_tests {
+    use super::*;
+    use std::process::Command;
+
+    #[test]
+    fn only_missing_dbus_api_errors_make_host_registration_optional() {
+        for name in [
+            "org.freedesktop.DBus.Error.UnknownInterface",
+            "org.freedesktop.DBus.Error.UnknownMethod",
+        ] {
+            let error = dbus::Error::new_custom(name, "deliberately misleading permission denied");
+            assert!(is_optional_host_registry_error(&error), "{name}");
+        }
+
+        for name in [
+            "org.freedesktop.DBus.Error.AccessDenied",
+            "org.freedesktop.DBus.Error.AuthFailed",
+            "org.freedesktop.DBus.Error.Failed",
+            "org.freedesktop.portal.Error.NotAllowed",
+        ] {
+            let error = dbus::Error::new_custom(name, "unknown method does not exist");
+            assert!(!is_optional_host_registry_error(&error), "{name}");
+        }
+    }
+
+    #[test]
+    fn private_bus_missing_interface_has_the_typed_optional_error() {
+        let output = Command::new("dbus-daemon")
+            .args(["--session", "--fork", "--print-address=1", "--print-pid=1"])
+            .output()
+            .expect("start private dbus-daemon");
+        assert!(output.status.success(), "{output:?}");
+        let stdout = String::from_utf8(output.stdout).expect("dbus-daemon output");
+        let mut lines = stdout.lines();
+        let address = lines.next().expect("private bus address");
+        let pid = lines.next().expect("private bus pid");
+
+        let conn = Connection::new_address(address).expect("connect to private bus");
+        let proxy = conn.with_proxy(
+            "org.freedesktop.DBus",
+            "/org/freedesktop/DBus",
+            Duration::from_secs(2),
+        );
+        let error = proxy
+            .method_call::<(), _, _, _>(HOST_REGISTRY_INTERFACE, "Register", ())
+            .expect_err("the private bus does not implement the host registry");
+        assert_eq!(
+            error.name(),
+            Some("org.freedesktop.DBus.Error.UnknownInterface")
+        );
+        assert!(is_optional_host_registry_error(&error));
+
+        let status = Command::new("kill")
+            .args(["-TERM", pid])
+            .status()
+            .expect("stop private dbus-daemon");
+        assert!(status.success());
+    }
+}
