                             BigInt(windowXid) === BigInt(xid);
                     });
                     if (matches.length !== 1) {
                         invocation.return_dbus_error(`${ERROR}.NotFound`,
                             `expected exactly one owned window for PID ${ownerPid}, XID ${xid}; found ${matches.length}`);
