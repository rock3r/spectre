+            nodes,
+            child,
+            child_key,
+            Some(key.clone()),
+            depth + 1,
+            request,
+            deadline,
+            window,
+            snapshot,
+        )?;
+    }
+    if children_truncated {
+        return node_limit_error(request.maximum_node_count, snapshot);
+    }
+    Ok(())
