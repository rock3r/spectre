+
+impl CachedExtras {
+    fn merge(&mut self, other: Self) {
+        if other.id.is_some() {
+            self.id = other.id;
+        }
+        if other.bounds.is_some() {
+            self.bounds = other.bounds;
+        }
+        if other.value.is_some() {
