+def _accesskit_fixture_pid(ready_line: str) -> int:
+    match = re.fullmatch(r"SPECTRE_ACCESSKIT_FIXTURE_READY(?:\s+.*)?\s+pid=([1-9]\d*)\s*", ready_line)
+    if match is None:
+        raise ValueError(f"fixture readiness did not report a valid positive pid: {ready_line!r}")
+    return int(match.group(1))
+
+
+@contextlib.contextmanager
+def _private_daemon_environment():
+    directory = Path(tempfile.mkdtemp(prefix="sp-a11y-", dir="/tmp"))
+    directory.chmod(0o700)
+    try:
+        yield {"SPECTRE_DAEMON_SOCKET_DIR": str(directory)}
+    finally:
+        shutil.rmtree(directory, ignore_errors=True)
+
+
+def _read_process_line(process: subprocess.Popen[str], *, timeout: float) -> str:
+    assert process.stdout is not None
+    result: queue.Queue[str | BaseException] = queue.Queue(maxsize=1)
+    def read() -> None:
+        try:
+            result.put(process.stdout.readline())
+        except BaseException as error:
+            result.put(error)
+    threading.Thread(target=read, daemon=True).start()
+    try:
+        value = result.get(timeout=timeout)
+    except queue.Empty as error:
+        raise TimeoutError("process did not emit a complete line before the deadline") from error
+    if isinstance(value, BaseException):
+        raise value
+    return value
+
+
+def _wait_for_accesskit_ready(process: subprocess.Popen[str], *, timeout: float = 30) -> str:
+    deadline = time.monotonic() + timeout
+    last_line = ""
+    while (remaining := deadline - time.monotonic()) > 0:
+        line = _read_process_line(process, timeout=remaining)
+        if not line:
+            raise RuntimeError(f"AccessKit fixture exited before ready: {last_line}")
+        last_line = line.strip()
+        if last_line.startswith("SPECTRE_ACCESSKIT_FIXTURE_READY"):
+            return last_line
+        if process.poll() is not None:
+            raise RuntimeError(f"AccessKit fixture exited before ready: {last_line}")
+    raise TimeoutError("AccessKit fixture did not report ready within 30s")
+
+
+def _process_group_has_live_members(group: int) -> bool:
+    """Return whether a Linux process group contains anything except dead zombies."""
+    proc = Path("/proc")
+    if not proc.is_dir():
+        try:
+            os.killpg(group, 0)
+            return True
+        except ProcessLookupError:
+            return False
+    for stat_path in proc.glob("[0-9]*/stat"):
+        try:
+            fields = stat_path.read_text().split()
+            if int(fields[4]) == group and fields[2] != "Z":
+                return True
+        except (FileNotFoundError, IndexError, PermissionError, ValueError):
+            continue
+    return False
+
+
+def _terminate_owned_process(process: subprocess.Popen[str]) -> None:
+    """Terminate the owned POSIX process group, even if its leader exits first."""
+    if os.name == "posix":
+        group = os.getpgid(process.pid)
+        try:
+            os.killpg(group, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        try:
+            process.wait(timeout=0.5)
+        except subprocess.TimeoutExpired:
+            pass
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline and _process_group_has_live_members(group):
+            time.sleep(0.05)
+        if _process_group_has_live_members(group):
+            try:
+                os.killpg(group, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+    elif process.poll() is None:
+        process.terminate()
+    try:
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        process.kill()
+        process.wait(timeout=5)
+    finally:
+        if process.stdout is not None:
+            process.stdout.close()
+
+
+@contextlib.contextmanager
+def _private_linux_dbus(required: bool):
+    if not required:
+        yield {}
+        return
+    process = subprocess.Popen(["dbus-daemon", "--session", "--nofork", "--print-address=1"], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
+    try:
+        address = _read_process_line(process, timeout=10).strip()
+        if not address:
+            raise RuntimeError("private D-Bus daemon emitted no session address")
+        yield {"DBUS_SESSION_BUS_ADDRESS": address}
+    finally:
+        _terminate_owned_process(process)
+
+
+def _linux_accessibility_enabled(env: dict[str, str]) -> bool:
+    completed = subprocess.run(["gdbus", "call", "--session", "--dest", "org.a11y.Bus", "--object-path", "/org/a11y/bus", "--method", "org.freedesktop.DBus.Properties.Get", "org.a11y.Status", "IsEnabled"], cwd=ROOT, env=env, check=True, capture_output=True, text=True, timeout=30)
+    match = re.search(r"\b(true|false)\b", completed.stdout, re.IGNORECASE)
+    if match is None:
+        raise RuntimeError(f"could not parse org.a11y.Status.IsEnabled: {completed.stdout!r}")
+    return match.group(1).lower() == "true"
+
+
+def _set_linux_accessibility_enabled(enabled: bool, env: dict[str, str]) -> None:
+    subprocess.run(["gdbus", "call", "--session", "--dest", "org.a11y.Bus", "--object-path", "/org/a11y/bus", "--method", "org.freedesktop.DBus.Properties.Set", "org.a11y.Status", "IsEnabled", f"<{str(enabled).lower()}>"], cwd=ROOT, env=env, check=True, capture_output=True, text=True, timeout=30)
+
+
+@contextlib.contextmanager
+def _linux_accessibility_for_smoke(env: dict[str, str]):
+    original = _linux_accessibility_enabled(env)
+    changed = not original
+    try:
+        if changed:
+            _set_linux_accessibility_enabled(True, env)
+        yield
+    finally:
+        if changed:
+            _set_linux_accessibility_enabled(False, env)
+
