# Leave both selectors empty to run the immutable public baseline only.  A review
# may pin either a subsequent commit or a cumulative patch relative to BASELINE_SHA.
CANDIDATE_SHA=
CANDIDATE_PATCH=
# Required whenever either selector above is set. These are git object IDs, not
# names: the workflow compares the reconstructed trees before it compiles anything.
CANDIDATE_FULL_TREE=
CANDIDATE_NATIVE_TREE=
